{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "dist",
    "paths": {
      "fsm/*": ["./src/fsm/*"],
      "log/*": ["./src/log/*"],
      "main/*": ["./src/main/*"],
      "db/*": ["./src/database/*"],
      "proto/*": ["./src/proto/*"],
      "audio/*": ["./src/audio/*"]
    },
    "rootDir": "src",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@weilasdk/monorepo",
  "private": true,
  "description": "Weila Web SDK monorepo (@weilasdk/core, @weilasdk/ui)",
  "scripts": {
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@vois/weila-sdk-core",
    "build:core:w": "turbo run dev --filter=@vois/weila-sdk-core",
    "build:ui": "turbo run build --filter=@vois/weila-sdk-ui",
    "dev": "turbo run dev",
    "dev:ui": "turbo run dev --filter=@vois/weila-sdk-ui",
    "story": "turbo run story --filter=@vois/weila-sdk-ui",
    "up": "pnpm dlx taze -Ir major",
    "build:story": "turbo run build:story",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "typecheck:parity": "node packages/core/scripts/typecheck-parity.mjs",
    "test:run": "turbo run test:run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "preview": "turbo run build --filter=@weilasdk/playground-vue3 && pnpm --filter @weilasdk/playground-vue3 run preview",
    "prepare": "simple-git-hooks",
    "lint:staged": "nano-staged",
    "contract:baseline": "node packages/core/scripts/artifact-contract.mjs --write",
    "contract:check": "node packages/core/scripts/artifact-contract.mjs"
  },
  "devDependencies": {
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "turbo": "^2.9.18"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": [
      "oxlint --type-aware",
      "oxfmt --check"
    ],
    "*.{json,jsonc,md,mdx,css,pcss,html,yml,yaml}": "oxfmt --check"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0"
}

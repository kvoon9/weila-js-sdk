{
  // knip finds unused files, exports and dependencies across the monorepo.
  // Run: pnpm knip  (gate must stay green; fix new findings, don't ignore them)
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Consumed by `pnpm run up` (taze reads this config at its own entry point)
  "workspaces": {
    ".": {
      // taze reads its config at its own entry point. The commit-hook spec runs
      // from `node --test` and has no importer.
      "entry": ["taze.config.js", "scripts/*.spec.mjs"],
    },
    "packages/core": {
      // Manual script: copies dist/assets into the consuming app's public/
      // (documented in packages/core/AGENTS.md, used by UniApp integrations)
      "entry": ["post-copy.js", "scripts/*.spec.mjs"],
    },
    "packages/ui": {
      // Icons are resolved at build time from CSS: `@plugin "@iconify/tailwind4"`
      // auto-discovers installed @iconify-json/* packages (see style.postcss.css)
      "ignoreDependencies": ["@iconify-json/carbon"],
    },
  },
  "ignore": [
    // Generated build output, gitignored but present on disk after builds
    "**/dist/**",
    // AudioWorklet bundles fetched at runtime by URL (see docs/AUDIO_PLAYBACK_FLOW.md)
    "playgrounds/vue3/public/**",
  ],
}
